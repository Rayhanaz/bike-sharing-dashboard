      "source": [
        "# Assessing Data\n",
        "print(\"=== Informasi Tipe Data ===\")\n",
        "print(day_df.info())\n",
        "\n",
        "print(\"\\n=== Jumlah Missing Values ===\")\n",
        "print(day_df.isna().sum())\n",
        "\n",
        "print(\"\\n=== Jumlah Data Duplikat ===\")\n",
